<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <text-property name="title">sample</text-property>
    <page-setup>
        <simple-master-page name="Page Master" id="2"/>
    </page-setup>
    <body>
        <grid id="3">
            <property name="width">100%</property>
            <column id="4"/>
            <column id="5"/>
            <row id="6">
                <cell id="7">
                    <image id="9">
                        <property name="source">url</property>
                        <expression name="uri">"https://mifos.org/wp-content/uploads/2017/05/Mifos-initiative-small-1.png"</expression>
                    </image>
                </cell>
                <cell id="8">
                    <label id="10">
                        <text-property name="text">Hello, Mifos Community!</text-property>
                        <!-- Custom Font Applied -->
                        <property name="fontFamily">GMX-Regular</property>
                        <property name="fontSize">24pt</property>
                        <property name="fontWeight">normal</property>
                        <property name="color">#2C3E50</property>
                    </label>
                </cell>
            </row>
        </grid>
    </body>
</report>