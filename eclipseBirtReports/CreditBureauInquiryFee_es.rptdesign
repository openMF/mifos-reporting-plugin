            <xml-property name="queryText"><![CDATA[SELECT 
    mst.created_on_utc AS transaction_date,
    mst.running_balance_derived AS balance,
    mc.display_name AS client_name,
    msa.account_no AS account_no,
    CASE mcu.code
        WHEN 'MXN' THEN 'PESO MEXICANO'
        WHEN 'USD' THEN 'DOLAR ESTADOUNIDENSE'
    END AS currency,
    mst.id AS reference,
    mof.name AS business_name,
    CONCAT('SUCURSAL - ', mof.name) AS office_name,
    '1' AS teller_no,
    UPPER(CONCAT(mau.firstname, ' ', mau.lastname)) AS cash_teller_name
FROM m_savings_account_transaction mst
LEFT JOIN m_savings_account msa ON msa.id = mst.savings_account_id
LEFT JOIN m_client mc ON msa.client_id = mc.id
LEFT JOIN m_office mof ON mof.id = mc.office_id
LEFT JOIN m_currency mcu ON msa.currency_code = mcu.code
LEFT JOIN m_appuser mau ON mau.id = mst.created_by
WHERE mst.id = ?]]></xml-property>
